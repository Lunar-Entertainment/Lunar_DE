#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -d "${SCRIPT_DIR}/../share/lunar-de" ]]; then
    SHARE_DIR="$(cd "${SCRIPT_DIR}/../share/lunar-de" && pwd)"
elif [[ -d "/usr/share/lunar-de" ]]; then
    SHARE_DIR="/usr/share/lunar-de"
else
    SHARE_DIR="/usr/local/share/lunar-de"
fi

if [[ -x "${SCRIPT_DIR}/lunar-panel" ]]; then
    LUNAR_PANEL="${SCRIPT_DIR}/lunar-panel"
else
    LUNAR_PANEL="$(command -v lunar-panel || echo /usr/bin/lunar-panel)"
fi

if [[ -x "${SCRIPT_DIR}/lunar-wm" ]]; then
    LUNAR_WM="${SCRIPT_DIR}/lunar-wm"
else
    LUNAR_WM="$(command -v lunar-wm || echo /usr/bin/lunar-wm)"
fi

unset WAYLAND_DISPLAY GIO_USE_VFS SESSION_MANAGER GNOME_DESKTOP_SESSION_ID GNOME_SHELL_SESSION_MODE GTK_MODULES GTK3_MODULES QT_ACCESSIBILITY
export DESKTOP_SESSION=lunar
export XDG_SESSION_DESKTOP=lunar
export XDG_SESSION_TYPE=x11
export XDG_CURRENT_DESKTOP=Lunar
export GDK_BACKEND=x11
export QT_QPA_PLATFORM=xcb
export SDL_VIDEODRIVER=x11
export CLUTTER_BACKEND=x11
export ELECTRON_OZONE_PLATFORM_HINT=x11
export GTK_USE_PORTAL=0
export NO_AT_BRIDGE=1
export GTK_A11Y=none

# Ensure xdg-desktop-portal resolves cleanly without gnome.portal fallback timeouts
PORTAL_USER_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/xdg-desktop-portal"
mkdir -p "${PORTAL_USER_DIR}"
cat > "${PORTAL_USER_DIR}/lunar-portals.conf" <<'EOF'
[preferred]
default=gtk;
org.freedesktop.impl.portal.Secret=gnome-keyring;
org.freedesktop.impl.portal.Background=none;
org.freedesktop.impl.portal.Clipboard=none;
org.freedesktop.impl.portal.GlobalShortcuts=none;
org.freedesktop.impl.portal.InputCapture=none;
org.freedesktop.impl.portal.RemoteDesktop=none;
org.freedesktop.impl.portal.ScreenCast=none;
org.freedesktop.impl.portal.Screenshot=none;
org.freedesktop.impl.portal.Usb=none;
org.freedesktop.impl.portal.Wallpaper=none;
EOF

PID_FILE="/tmp/lunar-de-pids.txt"
: > "${PID_FILE}"

if command -v systemctl >/dev/null 2>&1; then
    systemctl --user unset-environment \
        WAYLAND_DISPLAY GIO_USE_VFS SESSION_MANAGER GNOME_DESKTOP_SESSION_ID \
        GNOME_SHELL_SESSION_MODE GTK_MODULES GTK3_MODULES QT_ACCESSIBILITY \
        2>/dev/null || true
    systemctl --user import-environment \
        DISPLAY XAUTHORITY LANG LC_ALL DESKTOP_SESSION XDG_SESSION_DESKTOP \
        XDG_SESSION_TYPE XDG_CURRENT_DESKTOP GDK_BACKEND QT_QPA_PLATFORM \
        GTK_USE_PORTAL NO_AT_BRIDGE GTK_A11Y \
        2>/dev/null || true
fi

if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd \
        DISPLAY XAUTHORITY LANG LC_ALL DESKTOP_SESSION XDG_SESSION_DESKTOP \
        XDG_SESSION_TYPE XDG_CURRENT_DESKTOP GDK_BACKEND QT_QPA_PLATFORM \
        SDL_VIDEODRIVER CLUTTER_BACKEND ELECTRON_OZONE_PLATFORM_HINT \
        GTK_USE_PORTAL NO_AT_BRIDGE GTK_A11Y \
        2>/dev/null || true
fi

if command -v systemctl >/dev/null 2>&1; then
    systemctl --user reset-failed xdg-desktop-portal.service 2>/dev/null || true
    systemctl --user restart xdg-desktop-portal.service 2>/dev/null &
fi

CFG_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/lunar-de"
if [[ -f "${CFG_DIR}/monitor_layout.sh" ]]; then
    sh "${CFG_DIR}/monitor_layout.sh" 2>/dev/null || true
elif command -v xrandr >/dev/null 2>&1 && command -v python3 >/dev/null 2>&1; then
    python3 - <<'EOF' 2>/dev/null || true
import re, subprocess

out = subprocess.check_output(["xrandr", "--query"], text=True)
pattern = re.compile(
    r"^(\S+)\s+connected\s+(primary\s+)?(\d+x\d+)\+(\d+)\+(\d+)[^\n]*?(\d+)mm\s+x\s+\d+mm",
    re.M,
)
mons = []
for m in pattern.finditer(out):
    mons.append({
        "name": m.group(1),
        "primary": bool(m.group(2)),
        "res": m.group(3),
        "x": int(m.group(4)),
        "y": int(m.group(5)),
        "mm_w": int(m.group(6)),
    })

if len(mons) >= 2:
    prim = next((m for m in mons if m["primary"]), None)
    if prim is None:
        prim = max(mons, key=lambda m: m["mm_w"])
    rest = [m for m in mons if m["name"] != prim["name"]]
    cmd = ["xrandr", "--output", prim["name"], "--primary", "--auto", "--pos", "0x0"]
    prev = prim["name"]
    for sec in rest:
        cmd.extend(["--output", sec["name"], "--auto", "--right-of", prev])
        prev = sec["name"]
    subprocess.run(cmd, check=False)
EOF
fi

if command -v picom >/dev/null 2>&1 && [[ -f "${SHARE_DIR}/config/picom.conf" ]]; then
    if ! picom --config "${SHARE_DIR}/config/picom.conf" --backend glx --vsync </dev/null >/tmp/lunar-picom.log 2>&1 & then
        picom --config "${SHARE_DIR}/config/picom.conf" </dev/null >/tmp/lunar-picom.log 2>&1 &
    fi
    echo "$!" >> "${PID_FILE}"
fi

if command -v python3 >/dev/null 2>&1 && [[ -f "${SHARE_DIR}/scripts/lunar_live.py" ]]; then
    python3 "${SHARE_DIR}/scripts/lunar_live.py" </dev/null >/tmp/lunar-live.log 2>&1 &
    echo "$!" >> "${PID_FILE}"
fi

"${LUNAR_PANEL}" </dev/null >/tmp/lunar-panel.log 2>&1 &
echo "$!" >> "${PID_FILE}"

exec "${LUNAR_WM}" >/tmp/lunar-wm.log 2>&1
